<UserControl x:Class="Shammy.Views.AnswerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" Height="120">
    <Grid Margin="24,14,16,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Command results (timers, music...) show a glyph; calculator answers don't. -->
        <Border x:Name="GlyphOrb" Width="40" Height="40" CornerRadius="20" Background="{StaticResource Fill2}"
                Margin="0,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="17" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="Expression" FontSize="13" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Result" FontFamily="{StaticResource ShammyDisplayFont}" FontSize="34" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel x:Name="Actions" Grid.Column="2" VerticalAlignment="Center">
            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="OnCopy" />
            <Button x:Name="SearchWebButton" Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Search the web instead" Click="OnSearchWeb" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
