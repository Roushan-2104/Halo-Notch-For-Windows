<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Shammy.Views">

    <FontFamily x:Key="ShammyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ShammyDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="Fg" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Fg2" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="Fg3" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="Fill1" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Fill2" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="Fill3" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="Stroke1" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Green" Color="#FF30D158" />
    <SolidColorBrush x:Key="Red" Color="#FFFF453A" />
    <SolidColorBrush x:Key="Amber" Color="#FFFFD60A" />
    <!-- Replaced at startup with the user's Windows accent colour. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
    <!-- v2 design: one accent per kind of activity, card surfaces (see Modules/NotchCards.cs). -->
    <SolidColorBrush x:Key="MusicAccent" Color="#FFFF8A3D" />
    <SolidColorBrush x:Key="CalendarAccent" Color="#FF4C9AFF" />
    <SolidColorBrush x:Key="TimerAccent" Color="#FF5AC8FA" />
    <SolidColorBrush x:Key="BatteryAccent" Color="#FF34C759" />
    <SolidColorBrush x:Key="WeatherAccent" Color="#FFFFC233" />
    <SolidColorBrush x:Key="PurpleAccent" Color="#FFB48CFF" />
    <SolidColorBrush x:Key="AlarmAccent" Color="#FFFF453A" />
    <SolidColorBrush x:Key="CardBg" Color="#FF121214" />
    <SolidColorBrush x:Key="CardStroke" Color="#FF1F1F23" />
    <SolidColorBrush x:Key="CardText" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="CardText2" Color="#FFA1A1A6" />

    <!-- Focus Wall (the chosen design language; see .impeccable/surfaces and FOCUSWALL in the redesign notes):
         a deep neutral ground, colour only from each tile's artwork, ONE accent for focus and the primary control. -->
    <FontFamily x:Key="WallFont">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk</FontFamily>
    <FontFamily x:Key="WallFontMedium">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk Medium</FontFamily>
    <FontFamily x:Key="WallFontSemiBold">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk SemiBold</FontFamily>
    <FontFamily x:Key="WallFontExtraBold">pack://application:,,,/Assets/Fonts/#Schibsted Grotesk ExtraBold</FontFamily>
    <SolidColorBrush x:Key="WallGround" Color="#FF0B0B0D" />
    <SolidColorBrush x:Key="WallTile" Color="#FF16161A" />
    <SolidColorBrush x:Key="WallHairline" Color="#FF26282E" />
    <SolidColorBrush x:Key="WallText" Color="#FFF5F5F7" />
    <SolidColorBrush x:Key="WallText2" Color="#FFA3A3AB" />
    <SolidColorBrush x:Key="WallAccent" Color="#FFFF8A3D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF000000" />

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="999">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill1}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill2}" />
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{StaticResource Fill1}" CornerRadius="13" Padding="11,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Fg2}" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="13">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Armed by real pointer movement (see TabHover): IsMouseOver alone goes stale when the notch resizes under the pointer. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="views:TabHover.Armed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill1}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill2}" />
                            <Setter Property="Foreground" Value="{StaticResource Fg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v2 open notch: text chips in the top row (see Home.dc.html). Hover is armed by real movement, like TabButton. -->
    <SolidColorBrush x:Key="ChipHoverBg" Color="#FF1A1A1D" />
    <SolidColorBrush x:Key="RoundBg" Color="#FF232326" />
    <SolidColorBrush x:Key="RoundHoverBg" Color="#FF2E2E33" />
    <SolidColorBrush x:Key="TileBg" Color="#FF1A1A1D" />
    <SolidColorBrush x:Key="TileStroke" Color="#FF26262B" />
    <SolidColorBrush x:Key="TileHoverStroke" Color="#FF3A3A40" />

    <Style x:Key="V2Chip" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource CardText2}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="15" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="views:TabHover.Armed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ChipHoverBg}" />
                            <Setter Property="Foreground" Value="{StaticResource CardText}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RoundBg}" />
                            <Setter Property="Foreground" Value="{StaticResource CardText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v2 round control (Back, dismiss): a #232326 circle that lightens on hover. Size it with Width/Height. -->
    <Style x:Key="V2Round" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CardText}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{StaticResource RoundBg}" CornerRadius="999" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource RoundHoverBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- v2 text pill button ("Clear all"): same look as V2Round, sized to its text. -->
    <Style x:Key="V2Pill" TargetType="Button" BasedOn="{StaticResource V2Round}">
        <Setter Property="FontFamily" Value="{StaticResource ShammyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark Fluent-style context menus (used on notifications). -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="#F2202022" BorderBrush="{StaticResource Stroke1}" BorderThickness="1" CornerRadius="10" Padding="4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="FontFamily" Value="{StaticResource ShammyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,7">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fill2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F01C1C1E" />
        <Setter Property="Foreground" Value="{StaticResource Fg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke1}" />
        <Setter Property="FontFamily" Value="{StaticResource ShammyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
</ResourceDictionary>
