<UserControl x:Class="Halo.Views.DropView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480" Height="150">
    <Grid Margin="20,10,20,18">
        <Rectangle RadiusX="18" RadiusY="18" StrokeThickness="1.6" StrokeDashArray="5 3" Stroke="{DynamicResource AccentBrush}">
            <Rectangle.Fill>
                <SolidColorBrush Color="White" Opacity="0.04" />
            </Rectangle.Fill>
        </Rectangle>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="24" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Drop to keep it on the shelf" FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="Drag it back out whenever you need it" FontSize="11.5" Foreground="{StaticResource Fg2}" Margin="0,2,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
