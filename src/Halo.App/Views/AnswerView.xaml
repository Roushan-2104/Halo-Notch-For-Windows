<UserControl x:Class="Halo.Views.AnswerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" Height="120">
    <Grid Margin="24,14,16,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Expression" FontSize="13" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Result" FontFamily="{StaticResource HaloDisplayFont}" FontSize="34" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy" Click="OnCopy" />
            <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Search the web instead" Click="OnSearchWeb" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
