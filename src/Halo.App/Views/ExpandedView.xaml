<UserControl x:Class="Halo.Views.ExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Halo.Views"
             Width="480" Height="204">
    <Grid x:Name="CardGrid" Margin="22,8,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: tabs on the left (modules append theirs), battery on the right -->
        <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Center">
            <RadioButton x:Name="HomeTab" Style="{StaticResource TabButton}" GroupName="NotchTabs" Content="&#xE80F;"
                         IsChecked="True" ToolTip="Home" Checked="OnTabChanged" />
            <Grid Margin="4,0,0,0">
                <RadioButton x:Name="ShelfTab" Style="{StaticResource TabButton}" GroupName="NotchTabs" Content="&#xE7B8;"
                             ToolTip="Shelf" Checked="OnTabChanged" />
                <!-- File count, pinned to the shelf tab's top-right corner however many tabs follow it. -->
                <Border x:Name="ShelfBadge" Background="{DynamicResource AccentBrush}" CornerRadius="7" Height="14" MinWidth="14"
                        Padding="4,0" Margin="0,-6,-6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="ShelfCount" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <RadioButton x:Name="AlertsTab" Style="{StaticResource TabButton}" GroupName="NotchTabs" Content="&#xEA8F;"
                         Margin="4,0,0,0" ToolTip="Notifications" Checked="OnTabChanged" />
        </StackPanel>
        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="ShelfClear" Text="Clear" FontSize="12" Foreground="{StaticResource Fg2}" Cursor="Hand"
                       VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed" MouseLeftButtonUp="OnClearShelf" />
            <TextBlock x:Name="BatteryText" FontSize="12" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <views:BatteryIcon x:Name="Battery" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Home: now playing -->
        <Grid x:Name="MediaPanel" Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ArtFrame" Width="92" Height="92" CornerRadius="18" VerticalAlignment="Top" Cursor="Hand"
                    MouseLeftButtonUp="OnArtClicked" ToolTip="Play / pause" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,34,0" />
                <views:VisualizerBars x:Name="Bars" BarCount="5" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock x:Name="ArtistText" Grid.Row="1" FontSize="13" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                <Grid Grid.Row="3" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" FontSize="10.5" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" />
                    <Grid x:Name="Track" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="OnTrackDown" MouseMove="OnTrackMove" MouseLeftButtonUp="OnTrackUp">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Fill2}" VerticalAlignment="Center" />
                        <Border x:Name="TrackFill" Height="4" CornerRadius="2" Background="{StaticResource Fg}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                    </Grid>
                    <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource Fg2}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="16" Width="38" Height="34" Click="OnPrev" />
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="22" Width="46" Height="34" Margin="10,0" Click="OnPlayPause" />
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="16" Width="38" Height="34" Click="OnNext" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Home: nothing playing -->
        <Grid x:Name="ClockPanel" Grid.Row="1" Margin="2,6,0,0" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ClockText" FontFamily="{StaticResource HaloDisplayFont}" FontSize="46" FontWeight="Light" />
                <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Fg2}" Margin="2,-2,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" Foreground="{StaticResource Fg3}" Margin="0,0,8,0" />
                    <TextBlock Text="Nothing playing" FontSize="12.5" Foreground="{StaticResource Fg2}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Border Background="{StaticResource Fill2}" CornerRadius="5" Padding="6,1" Margin="0,0,6,0">
                        <TextBlock Text="Right Alt" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="hold to talk" FontSize="12.5" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource Fill2}" CornerRadius="5" Padding="6,1" Margin="0,0,6,0">
                        <TextBlock Text="Copilot" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="circle to search" FontSize="12.5" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Notification history -->
        <Grid x:Name="AlertsPanel" Grid.Row="1" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AlertsEmpty" Text="No notifications" FontSize="12.5" Foreground="{StaticResource Fg2}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer x:Name="AlertsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="AlertItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row" Height="48" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnAlertClicked">
                                <Border x:Name="RowBg" CornerRadius="12" Background="Transparent" Margin="-6,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Fill1}">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="13" Foreground="{StaticResource Fg3}" />
                                            <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding AppName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Body, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding TimeText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Fg3}"
                                               VerticalAlignment="Top" Margin="8,8,0,0" />
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Fill1}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Shelf -->
        <Grid x:Name="ShelfPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
            <Border x:Name="ShelfEmpty" CornerRadius="16" BorderThickness="1.2" BorderBrush="{StaticResource Fill3}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="22" Foreground="{StaticResource Fg3}" />
                    <TextBlock Text="Drag files onto the notch to keep them here" FontSize="12" Foreground="{StaticResource Fg2}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnShelfWheel" Focusable="False">
                <ItemsControl x:Name="ShelfItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Tile" Width="78" Height="112" Margin="0,0,6,0" Background="Transparent" Cursor="Hand"
                                  ToolTip="{Binding Path}"
                                  MouseLeftButtonDown="OnTileDown" MouseMove="OnTileMove" MouseLeftButtonUp="OnTileUp"
                                  MouseRightButtonUp="OnTileRightClick">
                                <Border x:Name="TileBg" CornerRadius="14" Background="Transparent" />
                                <StackPanel Margin="0,8,0,0">
                                    <Image Source="{Binding Icon}" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="6,6,6,0" Foreground="{StaticResource Fg}" />
                                </StackPanel>
                                <Border x:Name="RemoveButton" Width="18" Height="18" CornerRadius="9" Background="#FF3A3A3C"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,6,0" Visibility="Hidden"
                                        MouseLeftButtonDown="OnRemoveDown" ToolTip="Remove from shelf">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="8" Foreground="{StaticResource Fg}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileBg" Property="Background" Value="{StaticResource Fill1}" />
                                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
