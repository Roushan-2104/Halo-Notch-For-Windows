<UserControl x:Class="Halo.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Width="560" Height="680">
    <Grid Margin="14,8,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Thumb" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" Visibility="Collapsed"
                    BorderBrush="{StaticResource Stroke1}" BorderThickness="1" />
            <TextBlock x:Name="QueryIcon" Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Fg2}" Margin="2,0,10,0" />
            <TextBlock x:Name="QueryText" Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload" Click="OnReload" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in browser" Click="OnOpenInBrowser" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close (Esc)" Click="OnClose" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ModeAi" Style="{StaticResource Chip}" Content="AI Mode" Click="OnModeClick" />
                <ToggleButton x:Name="ModeWeb" Style="{StaticResource Chip}" Content="Web" Click="OnModeClick" />
                <ToggleButton x:Name="ModeLens" Style="{StaticResource Chip}" Content="Lens" Click="OnModeClick" />
                <Rectangle Width="1" Height="16" Fill="{StaticResource Fill3}" Margin="2,0,8,0" />
                <ToggleButton x:Name="FilterReddit" Style="{StaticResource Chip}" Content="Reddit" Click="OnFilterClick" />
                <ToggleButton x:Name="FilterRecent" Style="{StaticResource Chip}" Content="Past week" Click="OnFilterClick" />
                <ToggleButton x:Name="FilterNoJunk" Style="{StaticResource Chip}" Content="No junk" Click="OnFilterClick" />
                <ToggleButton x:Name="FilterDocs" Style="{StaticResource Chip}" Content="Docs" Click="OnFilterClick" />
                <StackPanel x:Name="ExtraChips" Orientation="Horizontal" />
            </StackPanel>
        </ScrollViewer>

        <!-- Its own row, never on top of the page: it must not cover Google's buttons. -->
        <Border x:Name="Notice" Grid.Row="2" Margin="0,6,0,0" CornerRadius="12" Padding="12,8,6,8"
                Background="{StaticResource Fill1}" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource Fg}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Google wants to check you're not a robot. Complete it below once; Halo remembers it after that." />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                        ToolTip="Dismiss" Click="OnDismissNotice" />
            </Grid>
        </Border>

        <Grid x:Name="WebFrame" Grid.Row="3" Margin="0,6,0,0" Background="#FF101012" SizeChanged="OnFrameSizeChanged">
            <wv2:WebView2CompositionControl x:Name="Web" DefaultBackgroundColor="#101012" />
            <Border x:Name="LoadingBar" Height="2.5" VerticalAlignment="Top" HorizontalAlignment="Left" Width="0"
                    Background="{DynamicResource AccentBrush}" CornerRadius="1.25" IsHitTestVisible="False" />
            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="26" Foreground="{StaticResource Fg3}" />
                <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{StaticResource Fg2}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
