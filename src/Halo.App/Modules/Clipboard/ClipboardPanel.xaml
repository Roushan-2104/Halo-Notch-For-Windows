<UserControl x:Class="Halo.Modules.ClipboardHistory.ClipboardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" FontSize="11.5" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" />
        <TextBlock x:Name="ClearButton" Text="Clear" FontSize="12" Foreground="{StaticResource Fg2}" Cursor="Hand"
                   HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Clear everything that isn't pinned"
                   MouseLeftButtonUp="OnClear" />

        <TextBlock x:Name="Empty" Grid.Row="1" Text="Copy something and it shows up here" FontSize="12.5"
                   Foreground="{StaticResource Fg2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Height="44" Background="Transparent" Cursor="Hand" ToolTip="{Binding Tip, Mode=OneTime}"
                              MouseLeftButtonUp="OnRowClicked">
                            <Border x:Name="RowBg" CornerRadius="12" Background="Transparent" Margin="-6,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Fill1}">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph, Mode=OneTime}" FontSize="13" Foreground="{StaticResource Fg2}" />
                                        <Border CornerRadius="8" Background="{Binding Thumb, Mode=OneTime}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, Mode=OneTime}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle, Mode=OneTime}" FontSize="11.5" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel x:Name="Meta" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,8,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE718;" FontSize="10" Foreground="{StaticResource Fg3}"
                                               Visibility="{Binding PinVisibility, Mode=OneTime}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding TimeText, Mode=OneTime}" FontSize="11" Foreground="{StaticResource Fg3}" />
                                </StackPanel>
                                <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Margin="8,0,0,0" Visibility="Hidden">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#FF3A3A3C" Cursor="Hand"
                                            ToolTip="{Binding PinTip, Mode=OneTime}" MouseLeftButtonUp="OnPinClicked">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding PinGlyph, Mode=OneTime}" FontSize="11" Foreground="{StaticResource Fg}" />
                                    </Border>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="#FF3A3A3C" Cursor="Hand" Margin="6,0,0,0"
                                            ToolTip="Remove" MouseLeftButtonUp="OnRemoveClicked">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="9" Foreground="{StaticResource Fg}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Fill1}" />
                                <Setter TargetName="Meta" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
