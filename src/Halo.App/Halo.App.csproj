<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 22621 projections (Windows 11 APIs like FocusSessionManager); still runs on Windows 10 2004+. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray NotifyIcon; its global usings are removed below to avoid WPF/WinForms name clashes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Halo</AssemblyName>
    <RootNamespace>Halo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>Halo.Program</StartupObject>
    <ApplicationIcon>..\..\assets\halo.ico</ApplicationIcon>
    <Product>Halo</Product>
    <!-- DPI awareness is declared in app.manifest for WPF; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF projects leave System.IO out of implicit usings; nothing here uses Shapes.Path unqualified. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <!-- QR codes: reading circled codes and showing phone-transfer links. -->
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Halo.Core\Halo.Core.csproj" />
  </ItemGroup>

</Project>
